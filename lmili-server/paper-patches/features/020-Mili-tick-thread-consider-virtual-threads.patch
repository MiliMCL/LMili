From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mili <dev@mili.dev>
Date: Mon, 16 Aug 2026 00:00:00 +0000
Subject: [PATCH] Mili: TickThread considers virtual threads with region context

Mili's RegionTickPool uses virtual threads for parallel chunk ticking.
Virtual threads are not TickThread instances, so Moonrise's
TickThread.ensureTickThread() and isTickThread() checks fail.

This patch makes isTickThread() and all isTickThreadFor() overloads return
true when RegionDataThreadLocal is set (i.e., the virtual thread is operating
within a valid region context). This eliminates the need to patch every
individual ensureTickThread call site.
---
 src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
--- a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
@@ -142,9 +142,14 @@ public class TickThread extends Thread {
         return (TickThread)Thread.currentThread();
     }

     public static boolean isTickThread() {
+        // Mili start - virtual threads with region context are considered tick threads
+        if (fun.bm.mili.lmili.thread.regiontick.RegionDataThreadLocal.getCurrent() != null) {
+            return true;
+        }
+        // Mili end
         return Thread.currentThread() instanceof TickThread;
     }

     public static boolean isShutdownThread() {
         return Thread.currentThread().getClass() == RegionShutdownThread.class;
@@ -175,6 +180,11 @@ public class TickThread extends Thread {

     public static boolean isTickThreadFor(final Level world, final int chunkX, final int chunkZ) {
+        // Mili start - virtual threads with region context are considered tick threads for their region
+        if (fun.bm.mili.lmili.thread.regiontick.RegionDataThreadLocal.getCurrent() != null) {
+            return true;
+        }
+        // Mili end
         final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region =
             TickRegionScheduler.getCurrentRegion();
         if (region == null) {
@@ -248,6 +258,11 @@ public class TickThread extends Thread {
         if (entity == null) {
             return true;
         }
+        // Mili start - virtual threads with region context are considered tick threads
+        if (fun.bm.mili.lmili.thread.regiontick.RegionDataThreadLocal.getCurrent() != null) {
+            return true;
+        }
+        // Mili end
         final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region =
             TickRegionScheduler.getCurrentRegion();
         if (region == null) {
