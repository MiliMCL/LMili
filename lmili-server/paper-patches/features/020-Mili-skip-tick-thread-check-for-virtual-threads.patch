From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mili <dev@mili.dev>
Date: Mon, 16 Aug 2026 00:00:00 +0000
Subject: [PATCH] Mili: Skip TickThread check for virtual threads

Mili's RegionTickPool uses virtual threads for parallel chunk ticking.
Virtual threads are not TickThread instances, so Moonrise's
TickThread.ensureTickThread() check fails with IllegalStateException.

This patch skips the check when running in a Mili virtual thread context
(detected via RegionDataThreadLocal).
---
 .../org/bukkit/craftbukkit/block/CraftBlock.java    | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/src/main/java/org/bukkit/craftbukkit/block/CraftBlock.java b/src/main/java/org/bukkit/craftbukkit/block/CraftBlock.java
index 123456789..abcdef012 100644
--- a/src/main/java/org/bukkit/craftbukkit/block/CraftBlock.java
+++ b/src/main/java/org/bukkit/craftbukkit/block/CraftBlock.java
@@ -82,7 +82,11 @@ public class CraftBlock {
     public net.minecraft.world.level.block.state.BlockState getBlockState() {
         // Folia start - region threading
         if (this.level instanceof ServerLevel serverWorld) {
-            ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(serverWorld, this.position, "Cannot read world asynchronously");
+            // Mili start - skip check for virtual threads with proper region context
+            if (fun.bm.mili.lmili.thread.regiontick.RegionDataThreadLocal.getCurrent() == null) {
+                ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(serverWorld, this.position, "Cannot read world asynchronously");
+            }
+            // Mili end
         }
         // Folia end - region threading
         return this.level.getBlockState(this.position);
--
2.40.0
