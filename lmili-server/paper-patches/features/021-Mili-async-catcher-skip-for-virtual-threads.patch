From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mili <dev@mili.dev>
Date: Mon, 16 Aug 2026 00:00:00 +0000
Subject: [PATCH] Mili: Skip AsyncCatcher check for virtual threads

Mili's RegionTickPool uses virtual threads for parallel chunk ticking.
Virtual threads are neither the main thread nor TickThread instances,
so Spigot's AsyncCatcher.checkOp() fails with IllegalStateException.

This patch skips the check when running in a Mili virtual thread context
(detected via RegionDataThreadLocal).
---
 src/main/java/org/spigotmc/AsyncCatcher.java | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/main/java/org/spigotmc/AsyncCatcher.java b/src/main/java/org/spigotmc/AsyncCatcher.java
index abcdef1..1234567 100644
--- a/src/main/java/org/spigotmc/AsyncCatcher.java
+++ b/src/main/java/org/spigotmc/AsyncCatcher.java
@@ -5,7 +5,13 @@ public class AsyncCatcher {

     public static void catchOp(String reason) {
-        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThread() && !fun.bm.mili.lmili.config.modules.experiment.DisableAsyncCatcherConfig.enabled) { // Paper - chunk system  // Luminol
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThread()
+                && !fun.bm.mili.lmili.config.modules.experiment.DisableAsyncCatcherConfig.enabled
+                // Mili start - skip check for virtual threads with proper region context
+                && fun.bm.mili.lmili.thread.regiontick.RegionDataThreadLocal.getCurrent() == null) {
+            // Mili end
             MinecraftServer.LOGGER.error("Thread {} failed main thread check: {}", Thread.currentThread().getName(), reason, new Throwable()); // Paper
             throw new IllegalStateException("Asynchronous " + reason + "!");
         }
