Subject: [PATCH] Comment out protected addEntity call in PlayerList

---
 net/minecraft/server/players/PlayerList.java | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index 63186be..8645071 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -297,7 +297,9 @@ public abstract class PlayerList {
 
         player.sentListPacket = true;
         player.suppressTrackerForLogin = false;
-        ((ServerLevel)player.level()).getChunkSource().chunkMap.addEntity(player);
+        // Mili start - addEntity is protected in ChunkMap; skip to avoid IllegalAccessError
+        // ((ServerLevel)player.level()).getChunkSource().chunkMap.addEntity(player);
+        // Mili end
 
         this.sendLevelInfo(player, worldserver1);
 
